# STEP 7: PCA Visualization (Quality Control & Batch Assessment)
# ------------------------------------------------------------------------------
cat("\n--- STEP 7: Generating PCA Visualizations ---\n")

generate_pca_plots <- function(expr_matrix, meta_df, title_prefix) {
  pca_obj <- prcomp(t(expr_matrix), scale. = TRUE)
  var_explained <- round(100 * (pca_obj$sdev^2 / sum(pca_obj$sdev^2)), 1)
  
  df_pca <- data.frame(
    PC1   = pca_obj$x[, 1],
    PC2   = pca_obj$x[, 2],
    Group = meta_df$Group,
    Batch = meta_df$Batch
  )
  
  p_batch <- ggplot(df_pca, aes(x = PC1, y = PC2, color = Batch)) +
    geom_point(alpha = 0.6, size = 1.8) +
    theme_bw() +
    labs(
      title = paste0(title_prefix, ": Technical Batches"),
      x = paste0("PC1 (", var_explained[1], "%)"),
      y = paste0("PC2 (", var_explained[2], "%)")
    )
  
  p_group <- ggplot(df_pca, aes(x = PC1, y = PC2, color = Group)) +
    geom_point(alpha = 0.6, size = 1.8) +
    scale_color_manual(values = c("Non_TNBC" = "#2b5c8f", "TNBC" = "#d95f02")) +
    theme_bw() +
    labs(
      title = paste0(title_prefix, ": Biological Subtypes"),
      x = paste0("PC1 (", var_explained[1], "%)"),
      y = paste0("PC2 (", var_explained[2], "%)")
    )
  
  return(list(batch = p_batch, group = p_group))
}

plots_raw       <- generate_pca_plots(combined_raw_matrix, master_metadata, "Raw Data")
plots_corrected <- generate_pca_plots(batch_corrected_matrix, master_metadata, "ComBat Corrected")

pca_panel <- grid.arrange(
  plots_raw$batch,       plots_corrected$batch,
  plots_raw$group,       plots_corrected$group,
  ncol = 2, nrow = 2
)

ggsave(file.path(output_dir, "PCA_Batch_Correction_Comparison.png"), plot = pca_panel, width = 12, height = 10, dpi = 300)
ggsave(file.path(output_dir, "PCA_Batch_Correction_Comparison.pdf"), plot = pca_panel, width = 12, height = 10)

