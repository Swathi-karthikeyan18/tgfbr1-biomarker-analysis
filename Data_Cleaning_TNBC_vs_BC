# Helper function: Convert probe IDs to Gene Symbols and average duplicates
process_matrix_to_symbols <- function(eset) {
  mat <- exprs(eset)
  
  # Auto Log2 transformation if data is raw intensity
  qx <- as.numeric(quantile(mat, c(0., 0.25, 0.5, 0.75, 0.99, 1.0), na.rm = TRUE))
  if (qx[5] > 100 || (qx[6] - qx[1] > 50 && qx[2] > 0)) {
    mat[mat <= 0] <- 1
    mat <- log2(mat)
  }
  
  # Map Probes to Gene Symbols using platform db
  symbols <- mapIds(
    hgu133plus2.db,
    keys = rownames(mat),
    column = "SYMBOL",
    keytype = "PROBEID",
    multiVals = "first"
  )
  
  valid <- !is.na(symbols)
  mat <- mat[valid, ]
  symbols <- symbols[valid]
  
  # Collapse duplicate gene symbols using mean expression
  mat_gene <- avereps(mat, ID = symbols)
  return(mat_gene)
}

# ------------------------------------------------------------------------------
# STEP 2: Download & Extract Cohorts in Exact Order
# ------------------------------------------------------------------------------
cat("--- STEP 2: Loading raw datasets from GEO ---\n")

# 1. GSE54002 Processing
gse54002_obj <- getGEO("GSE54002", GSEMatrix = TRUE)[[1]]
pheno_54002  <- pData(gse54002_obj)

# Exclude normal tissues (keep 419 primary tumors)
tumor_samples_54002 <- pheno_54002$geo_accession[grepl("tumor", pheno_54002$`tumor/nontumor:ch1`, ignore.case = TRUE)]
gse54002_obj <- gse54002_obj[, tumor_samples_54002]

gse54002_gene_mat <- process_matrix_to_symbols(gse54002_obj)

# Split into Non-TNBC (334) and TNBC (85)
gse54002_tnbc_cols    <- intersect(colnames(gse54002_gene_mat), tnbc_gsm_gse54002)
gse54002_nontnbc_cols <- setdiff(colnames(gse54002_gene_mat), gse54002_tnbc_cols)

mat_gse54002_nontnbc <- gse54002_gene_mat[, gse54002_nontnbc_cols]
mat_gse54002_tnbc    <- gse54002_gene_mat[, gse54002_tnbc_cols]

cat("GSE54002 Non-TNBC samples:", ncol(mat_gse54002_nontnbc), "\n")
cat("GSE54002 TNBC samples:", ncol(mat_gse54002_tnbc), "\n")

# 2. Download Remaining Target TNBC GSE Cohorts
other_gse_ids <- c("GSE157284", "GSE167213", "GSE58812", "GSE83937", "GSE95700")
other_matrices <- list()

for (id in other_gse_ids) {
  cat("Fetching", id, "...\n")
  gobj <- getGEO(id, GSEMatrix = TRUE)[[1]]
  other_matrices[[id]] <- process_matrix_to_symbols(gobj)
}

# ------------------------------------------------------------------------------
# STEP 3: Align Common Gene Features Across All Cohorts
# ------------------------------------------------------------------------------
cat("\n--- STEP 3: Intersecting common gene features ---\n")

all_matrices_list <- c(
  list(GSE54002_NonTNBC = mat_gse54002_nontnbc, GSE54002_TNBC = mat_gse54002_tnbc),
  other_matrices
)

common_genes <- Reduce(intersect, lapply(all_matrices_list, rownames))
cat("Total overlapping gene symbols across all cohorts:", length(common_genes), "\n")

# Subset each matrix to common gene space
all_matrices_aligned <- lapply(all_matrices_list, function(m) m[common_genes, ])

# Column-bind in exact requested order
combined_raw_matrix <- do.call(cbind, all_matrices_aligned)

# ------------------------------------------------------------------------------
# STEP 4: Build Structured Metadata Tracking Order & Subtypes
# ------------------------------------------------------------------------------
sample_ids <- colnames(combined_raw_matrix)

batch_vector <- c(
  rep("GSE54002", ncol(mat_gse54002_nontnbc) + ncol(mat_gse54002_tnbc)),
  unlist(lapply(names(other_matrices), function(id) rep(id, ncol(other_matrices[[id]]))))
)

group_vector <- c(
  rep("Non_TNBC", ncol(mat_gse54002_nontnbc)),
  rep("TNBC",     ncol(mat_gse54002_tnbc)),
  rep("TNBC",     sum(sapply(other_matrices, ncol)))
)

master_metadata <- data.frame(
  Sample_Order = 1:length(sample_ids),
  Sample_ID    = sample_ids,
  Group        = group_vector,
  Batch        = batch_vector,
  stringsAsFactors = FALSE
)

# ------------------------------------------------------------------------------
# STEP 5: Batch Effect Correction (ComBat) & Export
# ------------------------------------------------------------------------------
cat("\n--- STEP 5: Performing ComBat Batch Correction ---\n")

# Model matrix preserving biological phenotype (Group) across physical GEO batches
mod <- model.matrix(~ as.factor(Group), data = master_metadata)

batch_corrected_matrix <- ComBat(
  dat = combined_raw_matrix,
  batch = master_metadata$Batch,
  mod = mod,
  par.prior = TRUE
)

# Export structured, fully processed output files to D:\TNBC_RAW
cat("\n--- STEP 6: Saving master dataset files to D:/TNBC_RAW ---\n")

fwrite(as.data.table(combined_raw_matrix, keep.rownames = "Gene_Symbol"),
       file.path(output_dir, "Master_Raw_Aligned_Expression_Matrix.csv"))

fwrite(as.data.table(batch_corrected_matrix, keep.rownames = "Gene_Symbol"),
       file.path(output_dir, "Master_BatchCorrected_Expression_Matrix.csv"))

fwrite(master_metadata, file.path(output_dir, "Master_Sample_Metadata_Ordered.csv"))

